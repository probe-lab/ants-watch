# Copy to `.env` and adjust as needed:  cp .env.template .env

# ---- ClickHouse (used by the clickhouse + migrate services) ----
CLICKHOUSE_DB=ants_local
CLICKHOUSE_USER=ants_local
CLICKHOUSE_PASSWORD=changeme

# ---- ants-watch queen (read directly as ANTS_* env vars) ----
ANTS_NETWORK=agntcy

ANTS_CLICKHOUSE_HOST=clickhouse
ANTS_CLICKHOUSE_PORT=9000
ANTS_CLICKHOUSE_DATABASE=ants_local
ANTS_CLICKHOUSE_USER=ants_local
ANTS_CLICKHOUSE_PASSWORD=changeme
ANTS_CLICKHOUSE_SSL=false

# metrics are opt-in and must bind 0.0.0.0 so the published port is reachable
ANTS_METRICS_ENABLED=true
ANTS_METRICS_HOST=0.0.0.0
ANTS_METRICS_PORT=5999

# single DHT port, UPnP off (containers aren't publicly dialable anyway)
ANTS_FIRST_PORT=6000
ANTS_NUM_PORTS=1
ANTS_UPNP=false

# writable, ephemeral paths inside the container
ANTS_KEY_PATH=/tmp/keys.db
ANTS_CERTS_PATH=/tmp/p2p-forge-certs

# the queen reaches the nebula service (below) over gRPC
ANTS_NEBULA_SERVICE_HOST=nebula
ANTS_NEBULA_SERVICE_PORT=8282

# ---- nebula gRPC service (probe-lab/api, cmd/nebula) ----
NEBULA_LOG_FORMAT=text
NEBULA_LOG_LEVEL=info
NEBULA_SERVE_HOST=0.0.0.0
NEBULA_SERVE_PORT=8282

# The queen hard-codes its request to project=celestia network=mainnet, so the
# nebula service must serve that project/network from its ClickHouse databases.
NEBULA_SERVE_PROJECTS=celestia
NEBULA_SERVE_NETWORKS=mainnet

# nebula reads peer data from a SEPARATE ClickHouse (not the local one above).
# Fill in your own credentials:
NEBULA_SERVE_CLICKHOUSE_HOST=
NEBULA_SERVE_CLICKHOUSE_PORT=9440
NEBULA_SERVE_CLICKHOUSE_USER=
NEBULA_SERVE_CLICKHOUSE_PASSWORD=
NEBULA_SERVE_CLICKHOUSE_SSL=true
NEBULA_SERVE_CLICKHOUSE_DATABASES=ants_celestia_mainnet
