# Every environment variable ants-watch reads. Copy to `.env` and adjust:
#   cp .env.example .env
# Set values work with `just local-clickhouse`. Commented values are the defaults.

# ---- Network ----
# project + network select the DHT (bootstrap peers, protocol, user agent) and
# are the pair the queen requests from the Nebula service.
ANTS_PROJECT=celestia
ANTS_NETWORK=mainnet
# ANTS_USER_AGENT=          # derived from project and network when empty
# ANTS_BUCKET_SIZE=20

# ---- Ants ----
# ANTS_FIRST_PORT=6000
# ANTS_NUM_PORTS=128
# ANTS_UPNP=false
# ANTS_PUBLIC_IP=           # empty auto-detects it; 0.0.0.0 announces no public IPv4
# ANTS_KEY_PATH=keys.db
# ANTS_CERTS_PATH=p2p-forge-certs
# ANTS_CRAWL_INTERVAL=2h
# ANTS_CACHE_SIZE=10000
# ANTS_THROTTLE_TIMEOUT=5m  # 0 turns deduplication off
# ANTS_DEDUP_CACHE_SIZE=100000

# ---- Nebula service (gRPC) ----
ANTS_NEBULA_SERVICE_HOST=localhost
ANTS_NEBULA_SERVICE_PORT=8383

# ---- ClickHouse ----
# An empty host stores nothing: the queen then uses a no-op writer.
ANTS_CLICKHOUSE_HOST=localhost
ANTS_CLICKHOUSE_PORT=9000
ANTS_CLICKHOUSE_DATABASE=ants_local
ANTS_CLICKHOUSE_USER=ants_local
ANTS_CLICKHOUSE_PASSWORD=password
# The default is true; the local server has no TLS.
ANTS_CLICKHOUSE_SSL=false
# ANTS_CLICKHOUSE_CLUSTER=
# ANTS_BATCH_SIZE=1000
# ANTS_BATCH_TIME=20s

# ---- ClickHouse migrations (applied by the queen on startup) ----
# ANTS_CLICKHOUSE_MIGRATIONS_TABLE=schema_migrations
# ANTS_CLICKHOUSE_MIGRATIONS_TABLE_ENGINE=TinyLog
# ANTS_CLICKHOUSE_MIGRATIONS_REPLICATED_TABLE_ENGINES=false  # true on a ClickHouse cluster
# ANTS_CLICKHOUSE_MIGRATIONS_MULTI_STATEMENT=false
# ANTS_CLICKHOUSE_MIGRATIONS_MULTI_STATEMENT_MAX_SIZE=10485760

# ---- Logging ----
# ANTS_LOG_LEVEL=info
# ANTS_LOG_FORMAT=text
# ANTS_LOG_SOURCE=false

# ---- Metrics and traces ----
# `ants health` reads ANTS_METRICS_HOST and ANTS_METRICS_PORT too; its
# defaults are 127.0.0.1 and 5999.
ANTS_METRICS_ENABLED=true
ANTS_METRICS_HOST=localhost
ANTS_METRICS_PORT=5999
# ANTS_METRICS_PATH=/metrics
# ANTS_TRACING_ENABLED=false
# AWS_REGION=
